@startuml 04-ssd-registrar-atendimento
' PataAmiga — SSD UC-03 Registrar Atendimento Veterinário (seção 2.3)
' Visão caixa-preta: Veterinário ↔ :Sistema

skinparam shadowing false
skinparam sequenceArrowThickness 1.5
skinparam backgroundColor white
skinparam participant {
  BackgroundColor #FFF8E1
  BorderColor #B7791F
}
skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam note {
  BackgroundColor #F3F4F6
  BorderColor #9E9E9E
}

actor "Veterinário" as V
participant ":Sistema" as S

V -> S : buscarAnimal(idAnimal)
activate S
S --> V : {dadosAnimal, statusAtual, historico}
deactivate S

V -> S : registrarAtendimento(idAnimal, {data, tipo, descricao, procedimentos, vacinas, observacoes})
activate S
note right of S
  Cria RegistroVeterinario
  e atualiza Animal.status
  para EM_TRATAMENTO
  (include UC-07).
end note
S --> V : {idAtendimento, statusAnimal = EM_TRATAMENTO}
deactivate S

alt Liberar animal para adoção
  V -> S : emitirLaudoLiberacao(idAnimal, idAtendimento, parecerClinico)
  activate S
  note right of S
    Atualiza Animal.status
    para DISPONIVEL
    (include UC-07).
  end note
  S --> V : {idLaudo, statusAnimal = DISPONIVEL}
  deactivate S
end

@enduml
