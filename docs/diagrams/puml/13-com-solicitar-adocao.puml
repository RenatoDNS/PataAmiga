@startuml 13-com-solicitar-adocao
' PataAmiga — Diagrama de Comunicação do UC-01 Solicitar Adoção (seção 3.5)
' Mesma colaboração da sequência 10, vista como objetos numerados.

title Diagrama de Comunicação — UC-01 Solicitar Adoção

skinparam shadowing false
skinparam backgroundColor white
skinparam object {
  BackgroundColor #FFF8E1
  BorderColor #B7791F
}
skinparam object<<ator>> {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam object<<database>> {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

object "Adotante" as Ado <<ator>>

package "Frontend" {
  object ":SPA Angular" as SPA
}

package "Backend Spring Boot" {
  object ":JwtFilter" as JWT
  object ":AdocaoController" as AdoCtrl
  object ":AdocaoService" as AdoSvc
  object ":AnimalRepository" as AnimRepo
  object ":AdocaoRepository" as AdoRepo
}

object "PostgreSQL" as DB <<database>>

Ado      --> SPA      : 1: preencherFormulario(idAnimal, dados)
SPA      --> JWT      : 2: POST /api/v1/adocoes
JWT      --> AdoCtrl  : 3: criar(request) [token válido]
AdoCtrl  --> AdoSvc   : 4: solicitar(idAdotante, idAnimal, formulario)
AdoSvc   --> AnimRepo : 5: findById(idAnimal)
AnimRepo --> DB       : 6: SELECT animal
DB       --> AnimRepo : 7: row
AnimRepo --> AdoSvc   : 8: Animal [status==DISPONIVEL]
AdoSvc   --> AdoRepo  : 9: save(new Adocao(EM_ANALISE))
AdoRepo  --> DB       : 10: INSERT adocao
DB       --> AdoRepo  : 11: id
AdoRepo  --> AdoSvc   : 12: Adocao persistida
AdoSvc   --> AdoCtrl  : 13: AdocaoResponseDTO
AdoCtrl  --> JWT      : 14: 201 Created
JWT      --> SPA      : 15: response JSON
SPA      --> Ado      : 16: protocolo + status=EM_ANALISE

@enduml
